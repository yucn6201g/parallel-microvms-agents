# config.env にコピーして編集する (config.env は git 管理外)
#   macOS:   cp config.example.env config.env
#   Windows: Copy-Item config.example.env config.env   (PowerShell)
# 書式は KEY=VALUE。行末の「 # 」以降はコメント。Windows / macOS 共通で bin/mvm.py が読み込む

# ---- AWS
AWS_REGION=ap-northeast-1          # Lambda MicroVMs 対応リージョン (東京は対応済み)
# AWS_PROFILE=default
PMVA_PREFIX=pmva                    # リソース名・シークレット名のプレフィックス
STACK_NAME=pmva                     # CloudFormation スタック名
ENABLE_BEDROCK=true                 # 実行ロールに Bedrock 呼び出し権限を付けるか (infra deploy 時に反映)
BUDGET_MONTHLY_USD=0                # 月額の予算 (USD)。BUDGET_EMAIL と両方設定すると AWS Budgets のアラートを作る (アカウント全体の費用が対象)
BUDGET_EMAIL=                       # 予算アラートの通知先 (実績が 80% 超、予測が 100% 超で通知)

# ---- イメージ / VM サイズ
IMAGE_NAME=pmva-agent
BASE_IMAGE_ARN=                     # 空なら arn:aws:lambda:${AWS_REGION}:aws:microvm-image:al2023-1
MEMORY_MIB=4096                     # ベースライン。vCPU は 2GB あたり 1 (4096 => 2 vCPU)。ピーク時は最大 4 倍までバースト

# ---- 並列数 / ライフサイクル
MAX_AGENTS=10                       # 同時に起動できる MicroVM (= エージェント) の上限
MAX_DURATION_SECONDS=28800          # 1 セッションの最大寿命 (上限 8 時間)
IDLE_MAX_SECONDS=1800               # 外部からの通信がこの秒数無いと自動サスペンド。off で無効
IDLE_SUSPENDED_SECONDS=21600        # サスペンドのまま放置された場合に終了するまでの秒数
IDLE_AUTO_RESUME=true               # 通信が来たら自動でレジューム
INGRESS_CONNECTORS="HTTP_INGRESS SHELL_INGRESS"
SNAPSHOT_INTERVAL_SECONDS=1800      # ワークスペースを S3 に定期保存する間隔。0 で無効
KEEPALIVE_RATE_MINUTES=5            # 作業中の VM を AWS 側から起こし続ける間隔 (分)。0 で無効。IDLE_MAX_SECONDS より短くする (infra deploy 時に反映)
KEEPALIVE_ACTIVE_SECONDS=900        # 最後の作業 (画面の変化や CPU 使用) からこの秒数以内なら作業中とみなす (infra deploy 時に反映)

# ---- エージェントの既定値 (mvm up のオプションで上書き可能)
DEFAULT_AGENT=claude                # claude | codex | both | none
DEFAULT_CLAUDE_AUTH=oauth-token     # api-key | oauth-token | bedrock | gateway | interactive | none
DEFAULT_CODEX_AUTH=api-key          # api-key | chatgpt | interactive | none
DEFAULT_CLAUDE_ARGS=""              # 例: "--dangerously-skip-permissions" (VM は隔離環境)
DEFAULT_CODEX_ARGS=""               # 例: "--dangerously-bypass-approvals-and-sandbox"
BEDROCK_REGION=ap-northeast-1       # claude-auth=bedrock のときに使う Bedrock リージョン
CLAUDE_MODEL=                       # 例: Bedrock の推論プロファイル ID。空ならエージェント既定
USE_GITHUB_TOKEN=true               # Secrets Manager の ${PMVA_PREFIX}/github-token を使って clone/push する
NOTIFY_WEBHOOK=false                # true で、エージェントの完了・入力待ちを ${PMVA_PREFIX}/notify-webhook の URL (Slack など) に通知する

# ---- Git
GIT_USER_NAME=
GIT_USER_EMAIL=

# ---- SSH (mvm ssh / VS Code Remote-SSH 用)。ファイルが無ければ SSH ブリッジは起動しない
# ~ は macOS ではホーム、Windows では %USERPROFILE% (C:\Users\<名前>) に展開される
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub
